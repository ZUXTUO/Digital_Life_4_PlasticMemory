<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF0F5"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- 顶部导航标题栏 (微信/LINE 风格) -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/top_bar_background"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/top_bar_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:background="@drawable/avatar_isla_bg"
            android:gravity="center"
            android:text="@string/isla_name_short"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/top_bar_avatar"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/isla_full_name"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 在线绿点 -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/avatar_user_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/online_status"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 顶部右侧快捷按钮栏 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/top_log_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_log_bg"
                android:contentDescription="@string/log_button_description"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_log_premium" />

            <ImageButton
                android:id="@+id/top_web_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_web_bg"
                android:contentDescription="@string/web_activity_title"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_web_premium" />

        </LinearLayout>

    </RelativeLayout>

    <!-- 对话内容显示区域 -->
    <ScrollView
        android:id="@+id/chat_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_above="@+id/bottom_bar"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/chat_messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />

    </ScrollView>

    <!-- 底部微信/LINE 风格输入栏 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#F7F7F7"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- 文本输入框 -->
        <EditText
            android:id="@+id/user_input_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/input_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="40dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp"
            android:background="@drawable/edit_text_background"
            android:imeOptions="actionSend" />

        <!-- 录音按钮 (彩色微信绿) -->
        <ImageButton
            android:id="@+id/record_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_mic_bg"
            android:contentDescription="@string/start_recording"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic_premium"
            android:visibility="visible" />

        <!-- 发送按钮 (彩色微信绿) -->
        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_send_bg"
            android:contentDescription="@string/send_message"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send_premium"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 悬浮日志按钮 (紫靛色区分) -->
    <ImageButton
        android:id="@+id/log_float_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottom_bar"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/btn_log_bg"
        android:src="@drawable/ic_log_premium"
        android:contentDescription="@string/log_button_description"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <!-- 悬浮网页按钮 (青蓝色区分) -->
    <ImageButton
        android:id="@+id/web_float_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottom_bar"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_web_bg"
        android:src="@drawable/ic_web_premium"
        android:contentDescription="@string/web_activity_title"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:scaleType="fitCenter" />

</RelativeLayout>
